        },
        "extraction_source": {
          "type": "string",
          "description": "Where this signal comes from, e.g., 'file_scan', 'dependency_parser', 'git_api'"
        },
        "description": {
          "type": "string",
          "description": "What this signal represents"
        },
        "examples": {
          "type": "array",
          "items": {},
          "description": "Example values for this signal"
        }
      }
    },
    
    "EvaluationResult": {
      "type": "object",
      "required": ["scan_id", "repo", "evaluated_at", "rule_results"],
      "properties": {
        "scan_id": {
          "type": "string",
          "format": "uuid",
          "description": "Reference to the scan that produced this evaluation"
        },
        "repo": {
          "type": "string",
          "description": "Repository identifier, e.g., 'owner/repo'"
        },
        "commit_hash": {
          "type": "string",
          "description": "Git commit SHA that was evaluated"
        },
        "evaluated_at": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when evaluation was performed"
        },
        "rule_results": {
          "type": "array",
          "items": {
            "$ref": "#/entities/RuleResult"
          },
          "description": "Results for each applicable rule"
        },
        "evidence_collected": {
          "type": "array",
          "items": {
            "$ref": "#/entities/Evidence"
          },
          "description": "All evidence collected during evaluation"
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "rule_id": {"type": "string"},
              "missing_evidence": {"type": "array", "items": {"type": "string"}},
              "reason": {"type": "string"}
            }
          },
          "description": "Rules that could not be evaluated due to missing evidence"
        },
        "generated_findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "rule_id": {"type": "string"},
              "status": {"type": "string", "enum": ["FAIL", "UNKNOWN"]},
              "finding_id": {"type": "string", "format": "uuid"},
              "confidence": {"type": "number", "minimum": 0, "maximum": 1}
            }
          },
          "description": "Findings generated from rule evaluations"
        }
      }
    },
    
    "RuleResult": {
      "type": "object",
      "required": ["rule_id", "status"],
      "properties": {
        "rule_id": {
          "type": "string",
          "pattern": "^CRA-[A-Z]+-[0-9]{3}$"
        },
        "status": {
          "type": "string",
          "enum": ["PASS", "FAIL", "UNKNOWN", "NOT_APPLICABLE"],
          "description": "Evaluation result status"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Confidence in the evaluation result"
        },
        "evidence_used": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Evidence IDs that were used in evaluation"
        },
        "reason": {
          "type": "string",
          "description": "Explanation of the result, especially for UNKNOWN or NOT_APPLICABLE"
        },
        "evaluated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    
    "Evidence": {
      "type": "object",
      "required": ["evidence_id", "type", "source", "collected_at"],
      "properties": {
        "evidence_id": {
          "type": "string",
          "format": "uuid",
          "description": "Unique identifier for this evidence"
        },
        "type": {
          "type": "string",
          "enum": ["file_presence", "file_content", "dependency_list", "metadata", "signal_value"]
        },
        "source": {
          "type": "string",
          "description": "Where this evidence came from, e.g., file path or signal name"
        },
        "value": {},
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "collected_at": {
          "type": "string",
          "format": "date-time"
        },
        "metadata": {
          "type": "object",
          "description": "Additional context about the evidence"
        }
      }
    }
  },
  
