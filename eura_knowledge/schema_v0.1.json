{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema_version": "0.1",
  "generated_at": "2024-12-21T00:00:00Z",
  "description": "EURA Regulatory Knowledge Layer Schema for EU Cyber Resilience Act (CRA) compliance rules and evaluation outputs",
  
  "entities": {
    "Rule": {
      "type": "object",
      "required": ["rule_id", "title", "description_short", "regulation", "applicability", "check_method", "severity"],
      "properties": {
        "rule_id": {
          "type": "string",
          "pattern": "^CRA-[A-Z]+-[0-9]{3}$",
          "description": "Stable identifier for the rule, e.g., CRA-BASE-001"
        },
        "title": {
          "type": "string",
          "description": "Short human-readable title"
        },
        "description_short": {
          "type": "string",
          "maxLength": 200,
          "description": "Brief description of what the rule checks"
        },
        "description_long": {
          "type": "string",
          "description": "Detailed explanation of the rule"
        },
        "regulation": {
          "type": "string",
          "enum": ["CRA"],
          "description": "Regulatory framework this rule belongs to"
        },
        "applicability": {
          "type": "object",
          "description": "Boolean logic conditions that determine when this rule applies",
          "properties": {
            "operator": {
              "type": "string",
              "enum": ["AND", "OR", "NOT"],
              "description": "Logical operator for combining conditions"
            },
            "conditions": {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "signal": {"type": "string"},
                      "operator": {"type": "string", "enum": ["equals", "contains", "exists", "not_exists", "greater_than", "less_than"]},
                      "value": {}
                    }
                  },
                  {
                    "type": "object",
                    "properties": {
                      "operator": {"type": "string", "enum": ["AND", "OR", "NOT"]},
                      "conditions": {"$ref": "#/entities/Rule/properties/applicability/properties/conditions"}
                    }
                  }
                ]
              }
            },
            "metadata_filters": {
              "type": "object",
              "properties": {
                "repo_language": {"type": "array", "items": {"type": "string"}},
                "has_dockerfile": {"type": "boolean"},
                "has_cicd": {"type": "boolean"},
                "dependency_count_min": {"type": "integer"}
              }
            }
          }
        },
        "required_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/entities/EvidenceSpec"
          },
          "description": "List of evidence specifications needed to evaluate this rule"
        },
        "check_method": {
          "type": "string",
          "enum": ["repo_scan_static", "dependency_analysis", "file_presence", "content_analysis", "policy_attestation", "manual_review"],
          "description": "How this rule is evaluated"
        },
        "severity": {
          "type": "object",
          "required": ["overall"],
          "properties": {
            "impact": {
              "type": "string",
              "enum": ["critical", "high", "medium", "low"],
              "description": "Impact if this rule is violated"
            },
            "likelihood": {
              "type": "string",
              "enum": ["high", "medium", "low"],
              "description": "Likelihood of violation in typical repos"
            },
            "overall": {
              "type": "string",
              "enum": ["critical", "high", "medium", "low", "info"],
              "description": "Overall severity rating"
            }
          }
        },
        "remediation_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^REM-[0-9]{3}$"
          },
          "description": "References to remediation catalog entries"
        },
        "references": {
          "type": "object",
          "properties": {
            "article": {"type": "string", "description": "CRA article reference, e.g., 'Article 10(1)'"},
            "annex": {"type": "string", "description": "CRA annex reference"},
            "note": {"type": "string", "description": "Additional context or interpretation notes"}
          }
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$",
          "description": "Version of this rule definition"
        }
      }
    },
    
    "EvidenceSpec": {
      "type": "object",
      "required": ["type", "source"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["file_presence", "file_content", "dependency_list", "metadata", "signal_value"],
          "description": "Type of evidence needed"
        },
        "source": {
          "type": "string",
          "description": "Where to find this evidence, e.g., 'SECURITY.md', 'dependencies', 'git_tags'"
        },
        "required": {
          "type": "boolean",
          "default": false,
          "description": "Whether this evidence is mandatory for evaluation"
        },
        "pattern": {
          "type": "string",
          "description": "Optional regex pattern to match against content"
        },
        "min_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Minimum confidence threshold for this evidence"
        }
      }
    },
    
    "Signal": {
      "type": "object",
